# Copy this file to .env and fill in real values. Never commit .env.

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=

# Database — points at the PostgreSQL container from docker-compose (host port 5433).
# Start it with:  docker compose up -d db
DATABASE_URL=postgresql+psycopg2://neobus:neobus@localhost:5433/neobus_db

# SMTP (optional — falls back to console printing if SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@newbus.com
